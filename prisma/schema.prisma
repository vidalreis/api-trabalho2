// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// MODELOS
// ─────────────────────────────────────────────

// Role: "gerente" | "contador" | "dono"
// CompanyStatus: "ativo" | "inativo"
// Priority: "baixa" | "media" | "alta"
// TaskStatus: "pendente" | "em_progresso" | "concluida" | "cancelada"

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("contador")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  demands             Demand[]             @relation("AssignedDemands")
  templatesCreated    ChecklistTemplate[]  @relation("CreatedTemplates")
  assignmentsReceived ChecklistAssignment[] @relation("AssignedTo")
  assignmentsGiven    ChecklistAssignment[] @relation("AssignedBy")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  status    String   @default("ativo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  checklists  Checklist[]
  demands     Demand[]
  assignments ChecklistAssignment[]
}

model Checklist {
  id          String   @id @default(uuid())
  title       String
  serviceType String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Chave estrangeira
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Itens do checklist (tabela separada)
  items ChecklistItem[]
}

model ChecklistItem {
  id         String   @id @default(uuid())
  title      String
  completed  Boolean  @default(false)
  priority   String   @default("media")
  assignedTo String?

  // Chave estrangeira
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Demand {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("pendente")
  priority    String   @default("media")
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Chaves estrangeiras
  assignedToId String
  assignedTo   User    @relation("AssignedDemands", fields: [assignedToId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
}

model ChecklistTemplate {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Chave estrangeira
  createdById String
  createdBy   User   @relation("CreatedTemplates", fields: [createdById], references: [id])

  // Itens do template (tabela separada)
  items       ChecklistTemplateItem[]
  assignments ChecklistAssignment[]
}

model ChecklistTemplateItem {
  id       String @id @default(uuid())
  title    String
  priority String @default("media")

  // Chave estrangeira
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ChecklistAssignment {
  id        String   @id @default(uuid())
  status    String   @default("pendente")
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Chaves estrangeiras
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])

  assignedToId String
  assignedTo   User   @relation("AssignedTo", fields: [assignedToId], references: [id])

  assignedById String
  assignedBy   User   @relation("AssignedBy", fields: [assignedById], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Itens do assignment (cópia dos itens do template, com progresso)
  items ChecklistAssignmentItem[]
}

model ChecklistAssignmentItem {
  id         String  @id @default(uuid())
  title      String
  completed  Boolean @default(false)
  priority   String  @default("media")
  assignedTo String?

  // Chave estrangeira
  assignmentId String
  assignment   ChecklistAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}
